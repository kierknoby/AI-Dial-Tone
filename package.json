{
  "name": "ai-dial-tone-public",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/audit.mjs && node --test tests/*.test.mjs",
    "build:fixtures": "node tools/build-agent-fixtures.mjs",
    "build:docs": "python tools/build-reference.py",
    "build:site": "python tools/build-site.py && python tools/build-reference.py",
    "test:peer": "python -m unittest discover -s peer-lab/tests -p test_*.py -v",
    "test:byot": "python -m unittest discover -s byot/tests -p 'test_*.py' -v",
    "test:x402": "python -m unittest discover -s payments/tests -p 'test_*.py' -v",
    "test:handoff": "python -m unittest discover -s integration/tests -p 'test_*.py' -v"
  }
}
