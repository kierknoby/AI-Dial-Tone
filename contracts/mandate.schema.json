{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.dial-tone.uk/contracts/mandate.schema.json",
  "title": "AI Dial-Tone human-directed reservation mandate — design only",
  "description": "Lab-only schema. A JSON boolean is NOT evidence of verified human approval. Real deployment requires authenticated server-issued mandates.",
  "x-dialtone-status": "design_only_not_hosted",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mandate_id", "human_principal", "agent_id", "issued_at", "expires_at", "human_approved", "task", "limits"],
  "properties": {
    "version": {"const": "dialtone.peer.task.v1"},
    "mandate_id": {"type":"string","minLength":16,"maxLength":128,"pattern":"^[A-Za-z0-9_-]+$"},
    "human_principal": {"type":"string","minLength":3,"maxLength":100},
    "agent_id": {"type":"string","minLength":3,"maxLength":100},
    "issued_at": {"type":"string","format":"date-time"},
    "expires_at": {"type":"string","format":"date-time"},
    "human_approved": {"const":true},
    "task": {
      "type":"object","additionalProperties":false,
      "required":["kind","restaurant_name","destination","party_size","date","earliest","latest","customer_name","book_authorised","deposit_authorised","recording_authorised"],
      "properties": {
        "kind":{"const":"restaurant_reservation"},
        "restaurant_name":{"type":"string","minLength":2,"maxLength":120},
        "destination":{"type":"string","pattern":"^\\+44[12][0-9]{9}$"},
        "party_size":{"type":"integer","minimum":1,"maximum":12},
        "date":{"type":"string","format":"date"},
        "earliest":{"type":"string","pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "latest":{"type":"string","pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "customer_name":{"type":"string","minLength":2,"maxLength":80},
        "instructions":{"type":"string","maxLength":500},
        "book_authorised":{"const":true},
        "deposit_authorised":{"const":false},
        "recording_authorised":{"const":false}
      }
    },
    "limits":{"type":"object","additionalProperties":false,"required":["max_call_seconds","max_total_gbp_pence","max_attempts"],"properties": {
      "max_call_seconds":{"type":"integer","minimum":30,"maximum":300},
      "max_total_gbp_pence":{"type":"integer","minimum":0,"maximum":500},
      "max_attempts":{"const":1}
    }}
  }
}
